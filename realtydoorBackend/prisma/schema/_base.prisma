// ─── datasource + generator (must appear in exactly one file) ─────────────────

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  PARTNER
  ADMIN
}

enum PartnerSubType {
  AGENT
  BUILDER
  ADVISOR
  OWNER
}

enum PropertyType {
  FLAT
  INDEPENDENT_HOUSE
  VILLA
  PLOT
  COMMERCIAL_OFFICE
  RETAIL_SHOP
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum PublishStatus {
  PENDING_APPROVAL
  APPROVED
  // 4.15 — admin asked for specific fixes. Distinct from REJECTED: the
  // listing is still a live submission the partner is expected to correct and
  // resend, not a refusal. Hidden from every public surface, like
  // PENDING_APPROVAL.
  CHANGES_REQUESTED
  REJECTED
  ARCHIVED
}

enum PropertyStatus {
  PRE_LAUNCH
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  SOLD
  RENTED
}

enum LeadStatus {
  // Partner self-sourced the buyer and admin hasn't vetted it yet. Sits
  // before UNASSIGNED: admin confirms (→ UNASSIGNED/ASSIGNED), reassigns, or
  // drops it. Nothing in the OTP/visit/close flow accepts this status.
  AWAITING_ADMIN
  UNASSIGNED
  ASSIGNED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_DONE
  CLOSED
  DROPPED
}

// Where the lead came from. WEBSITE is the default because that's the only
// path that existed before admin/partner manual entry — every pre-existing
// row is a buyer who submitted through a property page.
enum LeadSource {
  WEBSITE
  PHONE
  WALK_IN
  REFERRAL
  EMAIL
  PARTNER
  OTHER
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  VERIFIED_BY_USER
}

enum EscrowStatus {
  PAYMENT_PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
  CANCELLED
  // A RazorpayX payout for this escrow was accepted (escrow went RELEASED)
  // but later failed/reversed asynchronously per a payout.failed/reversed
  // webhook — money didn't fully reach its destination. Needs manual admin
  // review; release()/refund() both reject anything that isn't HELD, so this
  // status deliberately blocks the normal retry path until someone looks.
  HELD_PAYOUT_FAILED
}

// The partner's own post-visit report (design artboard 50's status picker).
// Deliberately separate from BuyerFeedbackStatus below, which is what the
// BUYER told the WhatsApp bot — admin compares the two to catch a partner
// misreporting an outcome, so one must never overwrite the other.
// CLOSED/DROPPED are absent on purpose: those still go through
// PATCH /leads/partner/:id/close (Rule 6 — needs a HELD escrow) and
// /request-drop (needs admin approval). A free-text status write must not
// become a way around either gate.
enum VisitOutcome {
  STILL_DECIDING
  WANTS_ANOTHER_VISIT
  NEGOTIATING
}

enum BuyerFeedbackStatus {
  PENDING // WhatsApp sent, awaiting reply
  VERIFIED_CLOSED // Buyer confirmed deal is done
  VERIFIED_DROPPED // Buyer confirmed they are not proceeding
  STILL_DECIDING // Buyer replied "still deciding"
  NO_RESPONSE // 48h passed, no WhatsApp reply — Admin flagged
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum B2BConnectionStatus {
  INTERESTED
  CONNECTED
  CLOSED
}

// 11.2 — contact inbox workflow. SPAM is terminal and hides the row from the
// default inbox without deleting it, so a mis-flag is recoverable.
enum ContactStatus {
  NEW
  REPLIED
  RESOLVED
  SPAM
}

// 11.5 — where a contact message came from.
enum ContactSource {
  CONTACT_FORM
  PARTNER_SUPPORT
  USER_SUPPORT
  PRESS
  OUTBOUND
}

enum VideoTourStatus {
  PENDING
  ASSIGNED
  COMPLETED
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum CommissionStatus {
  PENDING
  INVOICED
  COLLECTED
  DISPUTED
}

enum DisputeType {
  LEAD
  ESCROW
  SERVICE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum LoanStatus {
  DOCUMENTS_PENDING
  DOCUMENTS_SUBMITTED
  DOCUMENTS_VERIFIED
  SENT_TO_BANK
  AWAITING_SANCTION
  SANCTIONED
  DISBURSED
  REJECTED
}

enum OtpPurpose {
  SIGNUP // new-account creation (name + email carried in payload)
  LOGIN // existing-account phone login
  GOOGLE_COMPLETE // linking + verifying phone after a Google sign-in
  PROFILE_VERIFY // lazy phone verification for an already-authenticated user
}
