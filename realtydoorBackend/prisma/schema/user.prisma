// ─── USER ─────────────────────────────────────────────────────────────────────
// Single model covers all 3 roles: USER / PARTNER / ADMIN
// partnerSubType is informational only — does NOT control permissions (PRD §2.1)

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  clerkId             String    @unique
  refCode             String?   @unique // RD-U-000123 — assigned by lib/refCode.js at creation; backfilled for pre-existing rows via scripts/backfillRefCodes.js, so every row now has one (every future row gets one at creation too)
  name                String
  // Not @unique here — soft-deleted rows (deletedAt set) must not permanently
  // reserve an email forever, or the same person could never sign up again
  // after being "deleted". Enforced instead by a partial unique index
  // (scripts/createEmailUniqueIndex.js) scoped to deletedAt: null, same
  // pattern as `phone` below. findUnique({where:{email}}) no longer works
  // against this field — use findFirst.
  email               String
  phone               String?
  phoneVerifiedAt     DateTime?
  phoneVerified       Boolean   @default(false)
  phoneVerifyDeadline DateTime? // grace period for pre-migration users without a verified phone (B9 backfill)
  emailVerified       Boolean   @default(false)
  // Deprecated — superseded by the PhoneOtp table. Code no longer reads/writes
  // these; kept only so a rollback isn't destructive. Dropped in a follow-up
  // migration once this deploy is confirmed stable (B9).
  phoneOtp            String?
  phoneOtpExpiresAt   DateTime?
  phoneOtpAttempts    Int       @default(0)
  phoneOtpLockedUntil DateTime?
  role                Role      @default(USER)
  isNRI               Boolean   @default(false)

  // Profile & settings (buyer-facing)
  address  String?
  language String? @default("en") // "en" | "kn" | "hi"

  // Buyer notification preferences (distinct from the partner notif* fields below)
  notifPush           Boolean @default(true)
  notifEmail          Boolean @default(true)
  notifWhatsapp       Boolean @default(true)
  notifMarketing      Boolean @default(false)
  notifVisitReminders Boolean @default(true)

  // Onboarding preferences — collected on the mandatory "let's get started"
  // step right after Google + phone verification (FRONTEND_HANDOFF_SPEC.md §8.4)
  buyerType     String? // "BUYER" | "RENTER" | "INVESTOR"
  preferredCity String?
  budget        String?
  bhk           String[]
  timeline      String? // "NOW" | "3_6_MONTHS" | "BROWSING"

  // Partner-specific fields
  partnerSubType  PartnerSubType?
  companyName     String?
  bio             String?
  profileImageUrl String?
  websiteUrl      String?

  // Premium B2B partner (Phase 2 — §3.2)
  isPremiumPartner  Boolean   @default(false)
  premiumValidUntil DateTime?
  premiumOrderId    String?

  // Structured partner identity (admin 3.2/3.3, partner B1.6/B1.8). These
  // were previously only readable by eyeballing the uploaded KYC documents.
  reraNumber    String?
  gstin         String?
  panNumber     String?
  coverageAreas String[]

  // ADVISOR persona's standard per-deal fee (business decision, 2026-10-04):
  // Advisor is normally paid a flat amount, not a % of the brokerage. This is
  // their default, used automatically when they're added as the ADVISOR line
  // on a lead (LeadCommissionLine.flatAmountPaise) unless admin overrides the
  // amount for that specific deal. Null means "no standard rate set yet" —
  // required at the point an advisor line is actually added with no override.
  advisorStandardFeePaise Int?

  // KYC (Partners only)
  kycStatus        KycStatus @default(NOT_SUBMITTED)
  kycDocumentUrls  String[]
  kycRejectionNote String?
  kycVerifiedAt    DateTime?

  // R9 — checklist of specific documents admin asked for, with a due date.
  // The due date is read-only informational: nothing auto-rejects when it
  // passes (see admin.service.js::kycRequestEffectiveStatus) — it is
  // reported as overdue for an admin to act on, the same non-destructive
  // default used for the listing change-request and owner-confirmation
  // timeouts elsewhere in this schema.
  kycRequestedDocuments String[]
  kycRequestedNote      String?
  kycRequestedAt        DateTime?
  kycRequestedDueAt     DateTime?
  kycRequestedByAdminId String?   @db.ObjectId
  kycConsentAt     DateTime? // POST /partner/kyc/consent — previously had nowhere to be recorded

  // B12.3 — partner acceptance of the commission/terms agreement. Versioned
  // because the agreement text changes: a partner who accepted v1 has to
  // accept again when v2 ships, so the version accepted is the record, not
  // just a boolean. IP is kept for the same evidentiary reason.
  partnerTermsVersion    String?
  partnerTermsAcceptedAt DateTime?
  partnerTermsAcceptedIp String?

  // Suspension (admin-managed)
  isSuspended   Boolean   @default(false)
  suspendedAt   DateTime?
  suspendReason String?

  // Soft-delete — Property.partner, Notification.user, and
  // PartnerSupportTicket.partner are all required relations with no
  // onDelete rule (Mongo/Prisma has none), so a hard prisma.user.delete()
  // on a user who owns any of those left a dangling foreign key that 500'd
  // every admin query trying to include it ("Field partner is required ...
  // got null"). clerk.handler.js's user.deleted handler and
  // jobs/cleanupIncompleteSignups.js both set this instead of deleting now.
  // Known limitation: email/clerkId stay @unique and are never freed, so the
  // same person can't sign up again with the same email after being
  // "deleted" — not solved here, flagging for whoever picks that up.
  deletedAt DateTime?

  // Onboarding consent (compliance audit trail)
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  marketingOptIn    Boolean   @default(false)
  marketingOptInAt  DateTime?

  // Partner — visit availability
  visitDays     String[] // e.g. ['Mon','Tue','Wed','Thu','Fri','Sat']
  visitFromTime String? // e.g. '10:00'
  visitToTime   String? // e.g. '19:00'

  // Partner — notification preferences
  notifNewLead        Boolean @default(true)
  notifLeadExpiring   Boolean @default(true)
  notifEscrowReleased Boolean @default(true)
  notifListingUpdate  Boolean @default(true)
  notifWeeklyReport   Boolean @default(false)

  // Partner — lead preferences
  leadAutoAccept          Boolean  @default(false)
  leadPauseOverloaded     Boolean  @default(true)
  leadPreferredLocalities String[]

  // Partner — bank account (for escrow payouts)
  bankName               String?
  bankBranch             String?
  bankAccountNo          String?
  bankIfsc               String?
  bankHolderName         String?
  // Vestigial. Route onboarding was evaluated and rejected in favour of
  // RazorpayX Payouts (direct bank transfer, no linked-account onboarding) —
  // see escrow.prisma. Kept only so old rows aren't silently dropped; nothing
  // reads it. The RazorpayX ids below are the live ones.
  razorpayRouteAccountId String?
  bankLinkedAt           DateTime?

  // R8 — billing details, for the commission invoice this partner is issued.
  // Separate from the bank fields above: this is who the invoice is
  // addressed to, not where the money lands. GSTIN already exists below
  // (`gstin`, 3.2/3.3/B1.6) — reused here rather than duplicated.
  // billingLegalName is deliberately distinct from companyName above: a
  // partner can trade under one name (companyName, shown throughout the
  // app) while being registered, for GST/invoicing purposes, under a
  // different legal entity name. billingAddress is likewise distinct from
  // the buyer-facing `address` field — that one is a buyer's personal
  // address, this is a business billing address.
  billingLegalName            String?
  billingAddress              String?
  billingAccountsContactName  String?
  billingAccountsContactEmail String?
  billingAccountsContactPhone String?

  // B12.1/B12.4 — RazorpayX payout account. A contact + fund account are
  // created once at onboarding and reused for every release, instead of being
  // rebuilt from the release request each time (which left no pre-validated
  // state and no status for the partner to see).
  razorpayContactId     String?
  razorpayFundAccountId String?
  // PENDING_VALIDATION → ACTIVE | NEEDS_CLARIFICATION | SUSPENDED.
  // NEEDS_CLARIFICATION is the penny-drop-failed / admin-flagged state that
  // the review and clarification screens read.
  payoutAccountStatus   String?
  payoutAccountNote     String?
  payoutValidatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties        Property[]
  assignedLeads     Lead[]                 @relation("PartnerLeads")
  buyerLeads        Lead[]                 @relation("BuyerLeads")
  partnerAddedLeads Lead[]                 @relation("PartnerAddedLeads")
  userDocuments     UserDocument[]
  subscriptions     UserSubscription[]
  tickets           ServiceTicket[]
  notifications     Notification[]
  favorites         Favorite[]
  b2bListings       B2BConnection[]        @relation("ListingPartner")
  b2bCollabs        B2BConnection[]        @relation("BuyerPartner")
  videoTourRequests VideoTourRequest[]
  contactMessages   ContactMessage[]
  loanApplications  LoanApplication[]
  disputes          Dispute[]
  reviews           PropertyReview[]
  supportTickets    PartnerSupportTicket[]
  commissionOverrides PartnerCommissionOverride[]
  changeRequests      PropertyChangeRequest[]
  builderProjects     Project[] @relation("BuilderProjects")
  mandates            ExclusiveMandate[]
  dataAcknowledgments PartnerDataAcknowledgment[]
  // R29 — advisor referrals: this user as the referring advisor, and
  // (separately) this user as a referred buyer, once matched.
  advisorReferrals    AdvisorReferral[] @relation("AdvisorReferrals")
  referredAsBuyer     AdvisorReferral[] @relation("ReferredAsBuyer")
  // R28 — brokerage invoices for units sold in this builder's own projects.
  builderInvoices     BuilderInvoice[]

  @@index([phone])
  @@index([deletedAt])
}
