// ─── SERVICE REQUEST ──────────────────────────────────────────────────────────
// Inbound interest from the public Services page / "request a callback"
// banners — a distinct lead type from ContactMessage so it can be triaged and
// reported on per-service (§6.2), instead of folded into generic contact copy.

model ServiceRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  phone      String
  email      String?
  serviceIds String[] @db.ObjectId
  note       String?
  source     String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@index([serviceIds])
}

// ─── SERVICE CATALOG ──────────────────────────────────────────────────────────
// Post-purchase services sold to users (MVP revenue stream 1).
// category: MAINTENANCE | CONSTRUCTION | LEGAL | LOAN | VALUATION

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  shortDesc   String
  description String
  price       Float
  category    String
  features    String[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserSubscription[]
}

// ─── USER SUBSCRIPTION ────────────────────────────────────────────────────────
// Created when a user buys a service. Activated via Razorpay payment.captured webhook.

model UserSubscription {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id])
  serviceId         String   @db.ObjectId
  service           Service  @relation(fields: [serviceId], references: [id])
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  paymentStatus     PaymentStatus @default(PENDING)
  amountPaid        Float
  currency          String   @default("INR")
  startDate         DateTime @default(now())
  endDate           DateTime

  tickets ServiceTicket[]

  @@index([userId])
  @@index([userId, paymentStatus])
}

// ─── SERVICE TICKET ───────────────────────────────────────────────────────────
// Raised by user under an active subscription. Resolved by Admin-dispatched vendor.
// User must mark VERIFIED_BY_USER to close (PRD Pattern 15 / Leakage 4).

model ServiceTicket {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String           @db.ObjectId
  user           User             @relation(fields: [userId], references: [id])
  subscriptionId String           @db.ObjectId
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id])
  propertyId     String?          @db.ObjectId
  property       Property?        @relation(fields: [propertyId], references: [id])
  subject        String
  description    String
  photos         String[]
  // category: PLUMBING | ELECTRICAL | PAINTING | GENERAL
  category       String?
  status         TicketStatus     @default(OPEN)
  // priority: NORMAL | HIGH | URGENT
  priority       String           @default("NORMAL")
  adminNotes     String?
  reopenReason   String?
  resolutionUrls String[]
  vendorName     String?
  vendorPhone    String?
  vendorRating        Int?
  vendorRatingComment String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?
  verifiedAt     DateTime?

  comments TicketComment[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([subscriptionId, status])
}

// ─── TICKET COMMENT ───────────────────────────────────────────────────────────
// Thread visible to both the buyer (ticket owner) and Admin's ticket detail view.

model TicketComment {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String        @db.ObjectId
  ticket     ServiceTicket @relation(fields: [ticketId], references: [id])
  authorId   String        @db.ObjectId
  authorRole String
  text       String
  photos     String[]
  createdAt  DateTime      @default(now())

  @@index([ticketId])
  @@index([ticketId, createdAt])
}
