// ─── SERVICE REQUEST ──────────────────────────────────────────────────────────
// Inbound interest from the public Services page / "request a callback"
// banners — a distinct lead type from ContactMessage so it can be triaged and
// reported on per-service (§6.2), instead of folded into generic contact copy.

model ServiceRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  phone      String
  email      String?
  serviceIds String[] @db.ObjectId
  note       String?
  source     String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@index([serviceIds])
}

// ─── SERVICE CATALOG ──────────────────────────────────────────────────────────
// Post-purchase services sold to users (MVP revenue stream 1).
// category: MAINTENANCE | CONSTRUCTION | LEGAL | LOAN | VALUATION

model Service {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  shortDesc   String
  description String
  price       Float
  category    String
  features    String[]
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions UserSubscription[]
}

// ─── USER SUBSCRIPTION ────────────────────────────────────────────────────────
// Created when a user buys a service. Activated via Razorpay payment.captured webhook.

model UserSubscription {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id])
  serviceId         String   @db.ObjectId
  service           Service  @relation(fields: [serviceId], references: [id])
  razorpayOrderId   String   @unique
  razorpayPaymentId String?
  paymentStatus     PaymentStatus @default(PENDING)
  amountPaid        Float
  currency          String   @default("INR")
  startDate         DateTime @default(now())
  endDate           DateTime

  tickets ServiceTicket[]

  @@index([userId])
  @@index([userId, paymentStatus])
}

// ─── SERVICE TICKET ───────────────────────────────────────────────────────────
// Raised by user under an active subscription. Resolved by Admin-dispatched vendor.
// User must mark VERIFIED_BY_USER to close (PRD Pattern 15 / Leakage 4).

model ServiceTicket {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  userId         String           @db.ObjectId
  user           User             @relation(fields: [userId], references: [id])
  subscriptionId String           @db.ObjectId
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id])
  propertyId     String?          @db.ObjectId
  property       Property?        @relation(fields: [propertyId], references: [id])
  subject        String
  description    String
  photos         String[]
  // category: PLUMBING | ELECTRICAL | PAINTING | GENERAL
  category       String?
  status         TicketStatus     @default(OPEN)
  // priority: NORMAL | HIGH | URGENT
  priority       String           @default("NORMAL")
  adminNotes     String?
  reopenReason   String?
  // 7.4 — "before" evidence from the user (photos, above) vs "after"
  // evidence from the vendor/admin at resolution (resolutionUrls). The
  // field existed but nothing ever wrote to it; resolveTicket now does.
  resolutionUrls String[]
  // 7.2 — vendorName/vendorPhone stay as a denormalized display cache (set
  // from the chosen Vendor at dispatch time, same pattern as Lead.buyerName
  // alongside buyerId) so existing list views keep working unchanged.
  // vendorId is the real link: what rating/job-count aggregation and
  // reassignment actually key off.
  vendorName     String?
  vendorPhone    String?
  vendorId       String?  @db.ObjectId
  vendor         Vendor?  @relation(fields: [vendorId], references: [id])
  // 7.2 — set at dispatch, not resolution: the vendor needs to know when to
  // show up and who/what to expect before they ever arrive.
  scheduledSlot       DateTime?
  tenantContactName   String?
  tenantContactPhone  String?
  quotedChargeAmount  Float?
  // 7.5 — set at resolution. totalCharge is stored (not derived) because
  // it's what the receipt below actually states and what the user was
  // actually charged, even if visit/parts are later corrected individually.
  visitCharge    Float?
  partsCharge    Float?
  totalCharge    Float?
  invoiceUrl     String?
  // 7.6 — "first-time verify rate" needs to know whether THIS ticket was
  // ever reopened before being verified, not just whatever reopenReason
  // happens to say — reopenTicket sets this once and it never resets.
  wasReopened    Boolean  @default(false)
  vendorRating        Int?
  vendorRatingComment String?
  // 7.8 — the deal (Lead) this post-purchase ticket traces back to, when
  // the service was bought as part of/after closing a property deal.
  // Nullable: most tickets are raised against a standalone subscription
  // with no specific deal behind it.
  leadId         String?  @db.ObjectId
  lead           Lead?    @relation(fields: [leadId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?
  verifiedAt     DateTime?

  comments TicketComment[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([subscriptionId, status])
  @@index([vendorId])
  @@index([leadId])
}

// ─── TICKET COMMENT ───────────────────────────────────────────────────────────
// Thread visible to both the buyer (ticket owner) and Admin's ticket detail view.

model TicketComment {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId   String        @db.ObjectId
  ticket     ServiceTicket @relation(fields: [ticketId], references: [id])
  authorId   String        @db.ObjectId
  authorRole String
  text       String
  photos     String[]
  createdAt  DateTime      @default(now())

  @@index([ticketId])
  @@index([ticketId, createdAt])
}
