// ─── PHONE OTP ────────────────────────────────────────────────────────────────
// Backs signup, login, Google-onboarding-completion, and lazy profile phone
// verification. Replaces the old phoneOtp* columns on User (see B9 — those
// columns are dropped in a follow-up migration once this is deployed).
// codeHash is HMAC-SHA256(code, OTP_HASH_SECRET) — never store the raw code.

model PhoneOtp {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  phone       String
  purpose     OtpPurpose
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  lockedUntil DateTime?
  // Security fix, 2026-10-13 (B8) — griefing counter. Verify is public by
  // design (see lib/otpAuth.js), so anyone who knows a phone number can
  // trigger the 5-wrong-guess lock deliberately, repeatedly, for free. Each
  // lock within 24h of the last one escalates the next lock's duration
  // (lib/otpAuth.js's lockDurationMs), so sustained harassment of the same
  // number gets steadily more expensive instead of resetting to a flat 10
  // minutes every time. Untouched by a normal resend, so a one-off real
  // lockout (someone fat-fingering their own code) doesn't escalate anything.
  // Nullable, not @default(0) non-null — existing PhoneOtp rows from before
  // this field existed are missing it entirely in Mongo, and a non-nullable
  // Int would fail to deserialize a document where the field is simply
  // absent. Code below treats a missing value as 0, same effect either way.
  lockCount    Int?
  lastLockedAt DateTime?
  sendCount   Int        @default(1)
  lastSentAt  DateTime   @default(now())
  payload     Json?      // { name, email } for SIGNUP; unused for other purposes
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([phone, purpose])
  @@index([phone])
  @@index([expiresAt])
}
