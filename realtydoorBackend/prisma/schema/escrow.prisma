// ─── ESCROW TRANSACTION ───────────────────────────────────────────────────────
// Mandatory token advance for every deal closure (PRD §5 — Leakage 3, Rule 6).
// Collects into the RealtyDoor RazorpayX current account, then releases to
// the seller via a RazorpayX Payout (direct bank transfer, no Route
// onboarding) or refunds to the buyer via the original Payment Gateway charge.
// A Lead cannot be marked CLOSED unless an EscrowTransaction { status: HELD } exists.

model EscrowTransaction {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  leadId            String       @db.ObjectId
  lead              Lead         @relation(fields: [leadId], references: [id])
  buyerId           String       @db.ObjectId
  razorpayOrderId    String       @unique
  razorpayPaymentId  String?
  razorpayTransferId String?      // legacy Route transfer id — pre-RazorpayX-migration releases only
  razorpayPayoutId   String?      // seller/primary payout
  razorpayPartnerPayoutId String? // optional second payout, when partnerDetails is given at release
  razorpayRefundId   String?
  // BE-6 — running total + dedup for refund.created, which previously
  // treated ANY refund amount as a full refund of the whole escrow. Summed
  // across every refundId seen (deduped, since a redelivered webhook must
  // not double count); REFUNDED is only set once this equals the amount.
  refundedAmountPaise Int?      @default(0)
  refundIds           String[]

  // R31 — a RazorpayX payout settles asynchronously after creation, so its
  // id alone (above) doesn't say whether the money actually landed. Status
  // mirrors RazorpayX's own payout.status values (queued/pending/processing/
  // processed/reversed/cancelled/rejected/failed): set from the synchronous
  // create response at release time, then corrected by the payout.processed
  // / payout.failed / payout.reversed webhooks as RazorpayX settles each leg.
  // UTR is only ever present once a payout reaches "processed".
  sellerPayoutStatus  String?
  sellerPayoutUtr     String?
  partnerPayoutStatus String?
  partnerPayoutUtr    String?
  // BE-20 — RazorpayX's failure_reason/status_details.description, from
  // payout.failed/payout.reversed, previously discarded (only the bare
  // status was kept). Per-leg, independent of adminNote's free text.
  sellerPayoutFailureReason  String?
  partnerPayoutFailureReason String?

  amount    Float
  // Money model Rev 3 — the buyer pays the token PLUS a payment processing
  // fee (token / 0.9764, rounded up to the rupee, setting-driven). `amount`
  // stays the token alone, so every release/refund calculation that reads it
  // keeps working; the Razorpay order is for chargedPaise.
  processingFeePaise    Int?
  chargedPaise          Int?
  // Refund outcome (BUYER_WITHIN_WINDOW | BUYER_AFTER_WINDOW | SELLER_BACKOUT |
  // LISTING_WRONG | OUR_FAULT | ADMIN_TOKEN_ONLY) and the cancellation charge
  // kept from a refund after the free window.
  refundReason          String?
  cancellationChargePaise Int?
  // Partner commission at release (1% of the deal price, TDS taken inside).
  // partnerShareAmount/partnerSharePaise remain the NET actually paid.
  // partnerPaidFromCompany = true: the commission is NOT taken out of the
  // token (the token goes to the seller whole), so refund-remaining must not
  // subtract it. Absent on rows released the old way.
  partnerGrossPaise      Int?
  partnerTdsPaise        Int?
  partnerGstPendingPaise Int?
  partnerPaidFromCompany Boolean?
  // BE-9 — integer paise, additive alongside the existing Float rupee
  // fields (never a replacement — every existing API response keeps
  // reading the rupee field unchanged). Backfilled for pre-existing rows by
  // scripts/backfillPaise.js. Float rupees drift at the margins (49999.99
  // stored/read back is not guaranteed bit-exact); paise is what's actually
  // sent to Razorpay/RazorpayX, so it's the one worth keeping exact.
  amountPaise Int?
  currency  String       @default("INR")
  // R30 — what the seller actually netted at release (amount minus whatever
  // was held back for partner/platform). Only ever set by release() itself;
  // null before that, since there is nothing to show yet. The "in-review"
  // (pre-release) equivalent is computed on the fly by getReleasePlan, not
  // stored here, because it's a projection that can still change before the
  // real release happens.
  netAmount Float?
  netAmountPaise Int?
  // BE-2 — the partner leg has no equivalent of netAmount's durable record;
  // without this, a retried partner payout (after the original failed) has
  // no stored amount to retry with. Set alongside netAmount at release() time.
  partnerShareAmount Float?
  partnerSharePaise  Int?
  // BE-9 — the platform's retained cost-recovery amount at release time, in
  // paise (release()'s rupee platformFee is still what's shown/audited).
  platformFeePaise Int?
  // BE-17 — the % used to compute platformFeePaise, stored on the row so a
  // later config change to escrow_platform_fee_pct never alters the fee
  // already recorded as retained on an already-RELEASED escrow (previously
  // only ever written into adminNote text and the audit log, not queryable).
  platformFeePct   Float?

  status      EscrowStatus @default(PAYMENT_PENDING)
  heldAt      DateTime?
  releasedAt  DateTime?
  refundedAt  DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  releasedByAdminId String?  @db.ObjectId
  adminNote         String?

  // BE-1 — bumped only by the BE-2 retry route, never by release() itself.
  // Folded into createPayout's idempotency key (with amountPaise) so a
  // retried release with the SAME amount dedupes against RazorpayX, but a
  // deliberate retry with a changed amount/account gets a fresh key instead
  // of being silently deduped against the failed attempt. Nullable, not
  // @default(0) non-null — every pre-existing row is missing this field
  // entirely in Mongo, and a non-nullable Int fails to deserialize a
  // document where the field is simply absent (code treats missing as 0).
  payoutAttempt Int?

  // BE-2 — set by POST /admin/escrow/:id/payouts/resolve, the manual way out
  // of HELD_PAYOUT_FAILED when a payout can't be retried (e.g. paid outside
  // Razorpay, or confirmed landed despite the webhook/API disagreeing).
  resolvedAt        DateTime?
  resolvedByAdminId String?   @db.ObjectId
  resolution        String?

  // R10 — freeze for dispute.
  frozenAt        DateTime?
  frozenReason    String?
  frozenByAdminId String?   @db.ObjectId
  unfrozenAt      DateTime?
  autoEscalatedAt   DateTime? // set once an overdue-HELD notification has fired, so the daily job doesn't re-notify
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([leadId])
  @@index([buyerId])
  @@index([status])
  @@index([status, createdAt])
}
