// ─── LEAD ─────────────────────────────────────────────────────────────────────
// Central unit of the anti-leakage engine (PRD §5).
// buyerPhone is stored plain; masking is computed at the API layer via formatPhone().
// siteVisitOTP is cleared from DB after successful verification.

model Lead {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  refCode           String?   @unique // RD-L-000123 — see User.refCode's comment; backfilled, now unique
  buyerName         String
  buyerEmail        String
  buyerPhone        String
  buyerId           String?    @db.ObjectId
  buyer             User?      @relation("BuyerLeads", fields: [buyerId], references: [id])
  buyerMessage      String?
  // Optional since admin can log a lead for a property that isn't listed yet
  // (POST /admin/leads) — propertyInterest below carries the free text in
  // that case. Buyer-submitted and partner-added leads always set it.
  // Consumers must treat `property` as nullable.
  propertyId        String?    @db.ObjectId
  property          Property?  @relation(fields: [propertyId], references: [id])
  propertyInterest  String? // free text, only when propertyId is null
  budget            String?
  source            LeadSource @default(WEBSITE)
  status            LeadStatus @default(UNASSIGNED)

  // Manual entry provenance — exactly one of these is set (neither, for a
  // buyer's own WEBSITE submission).
  addedByPartnerId String? @db.ObjectId
  addedByPartner   User?   @relation("PartnerAddedLeads", fields: [addedByPartnerId], references: [id])
  addedByAdminId   String? @db.ObjectId

  // docs-backend-gaps-handoff.md #4 — required when a THIRD PARTY (partner or
  // admin) is the one claiming this buyer's data; the buyer hasn't directly
  // interacted with the platform, so someone else is attesting consent on
  // their behalf. Not required for a buyer's own WEBSITE submission — they
  // are the one submitting, so there is no third party to attest for them.
  // Timestamp-presence, the same convention as User.kycConsentAt /
  // partnerTermsAcceptedAt elsewhere in this schema, rather than a bare
  // boolean — it is also the evidentiary record of *when* consent was given.
  buyerConsentAt DateTime?

  // Repeat buyer: this lead is the same person enquiring about a different
  // property, linked back to their earlier lead so admin sees the history.
  // Plain scalar, deliberately NOT a Prisma @relation. Prisma requires
  // self-relations to use onDelete: NoAction (SetNull is rejected), which made
  // any lead referenced as a repeat-buyer parent permanently undeletable — and
  // submitLead's race-guard rollback deletes the lead it just created. The link
  // is informational, so a dangling id after a delete is fine and callers
  // resolve it with an explicit lookup. Same pattern as addedByAdminId and
  // droppedByAdminId above/below.
  relatedLeadId String? @db.ObjectId
  assignedPartnerId String?    @db.ObjectId
  assignedPartner   User?      @relation("PartnerLeads", fields: [assignedPartnerId], references: [id])
  assignedAt        DateTime?
  adminNotes        String?

  // OTP anti-leakage (PRD §5 — Rules 1, 2, 3)
  siteVisitScheduledAt DateTime?
  siteVisitOTP         String? // cleared after verification
  otpGeneratedAt       DateTime?
  otpExpiresAt         DateTime? // = otpGeneratedAt + OTP_EXPIRY_MINUTES
  otpAttempts          Int       @default(0)
  otpLockedUntil       DateTime? // set after OTP_MAX_ATTEMPTS failures
  isOtpVerified        Boolean   @default(false)
  otpVerifiedAt        DateTime?

  // Partner's request for Admin to unlock a locked OTP (§12.3) — a real,
  // queryable queue, not just a notification. Only an admin action clears it.
  otpOverrideRequestedByPartner Boolean   @default(false)
  otpOverrideRequestedAt        DateTime?

  // WhatsApp buyer feedback cross-check (PRD §5 — Leakage 1)
  whatsappSentAt      DateTime?
  buyerFeedbackStatus BuyerFeedbackStatus?
  feedbackReceivedAt  DateTime?

  // Partner documentation
  visitNotes          String?
  visitPhotoUrls      String[]
  closureDocumentUrls String[]
  partnerNotes        String?

  // B5.1/B5.3/B5.4 + admin 2.4 — the mark-as-closed gate. The allocation
  // letter is mandatory before closeLead will accept a deal (alongside the
  // existing Rule 6 HELD-escrow check).
  closingPrice               Float?
  allocationLetterUrl        String?
  allocationLetterUploadedAt DateTime?
  tokenReceiptUrl            String?

  // 6.7 — who revealed the buyer's real phone, when, from where. The OTP
  // verification is the reveal event; this is the audit trail for it.
  contactRevealedAt          DateTime?
  contactRevealedByPartnerId String?   @db.ObjectId
  contactRevealedIp          String?

  // Partner's post-visit outcome report — see enum VisitOutcome. Distinct
  // from buyerFeedbackStatus above (the buyer's own answer to the bot).
  visitOutcome   VisitOutcome?
  visitOutcomeAt DateTime?

  // Buyer → partner rating (post site-visit / closure)
  buyerRating        Int?
  buyerRatingComment String?
  buyerRatedAt       DateTime?

  // 7-day re-ping for STILL_DECIDING (Appendix C.4)
  secondFollowupSentAt DateTime?

  // Two-tier drop system (Appendix C.2)
  dropRequestedByPartner Boolean   @default(false)
  dropRequestNote        String?
  dropRequestedAt        DateTime?
  droppedReason          String?
  droppedAt              DateTime?
  droppedByAdminId       String?   @db.ObjectId

  // Commission (docs 3.12-3.17). The authoritative terms are
  // commissionLines below; these two are DERIVED from the locked lines and
  // kept because netAmount and the finance views already read them.
  //
  // feePct is lead-level because the fee itself is negotiated per deal — the
  // rate card only supplies a default.
  feePct                Float?
  dealPriceAtLock       Float?
  commissionLockedAt    DateTime?
  commissionVersion     Int       @default(1)
  // Which template this was pre-filled from, for 3.13's change history.
  rateCardId            String?   @db.ObjectId
  rateCardVersion       Int?
  commissionLines       LeadCommissionLine[]

  platformCommissionPct Float?
  commissionAmountPaise Int?
  commissionStatus      CommissionStatus @default(PENDING)
  invoiceUrl            String?
  invoicedAt            DateTime?
  collectedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escrowTransactions EscrowTransaction[]

  @@index([assignedPartnerId])
  @@index([buyerId])
  @@index([status])
  @@index([propertyId])
  @@index([buyerFeedbackStatus])
  @@index([dropRequestedByPartner])
  @@index([otpOverrideRequestedByPartner])
  @@index([assignedPartnerId, status])
  @@index([status, createdAt])
  @@index([propertyId, status])
  @@index([buyerId, createdAt])
  @@index([commissionStatus])
}
