// ─── PROPERTY ─────────────────────────────────────────────────────────────────

model Property {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  slug              String         @unique
  description       String
  price             Float?
  previousPrice     Int?
  priceChange6m     Int?
  monthlyRent       Float?
  priceNegotiable   Boolean        @default(false)
  propertyType      PropertyType
  listingType       ListingType    @default(SALE)
  propertyStatus    PropertyStatus @default(READY_TO_MOVE)
  publishStatus     PublishStatus  @default(PENDING_APPROVAL)
  rejectionNote     String?
  adminEditNote     String?
  isFeatured        Boolean        @default(false)
  isFeaturedProject Boolean        @default(false)

  // 4.14 — the middle rung of the three visibility levels an admin picks on
  // approval: public (reachable at its own URL, i.e. publishStatus APPROVED),
  // searchable (this field), and homepage-featured (isFeatured).
  //
  // Nullable, and null means SEARCHABLE. A Boolean @default(true) would be
  // *missing* rather than true on every listing that already exists, and a
  // required field has no `isSet` filter to find them with — so the 18 live
  // listings would have silently dropped out of search. Verified against the
  // database: { isSet: false } matches those rows, while both `null` and
  // `{ not: false }` match zero of them.
  isSearchable      Boolean?

  // 4.15 — the checklist an admin sends back with CHANGES_REQUESTED. Replaced
  // wholesale on each request and cleared when the partner resubmits; the
  // durable history lives in PropertyEditLog and AuditLog as it does for every
  // other admin action.
  requestedChanges          String[]
  requestedChangesNote      String?
  changesRequestedAt        DateTime?
  changesRequestedByAdminId String?   @db.ObjectId
  isB2BOnly         Boolean        @default(false)

  // Physical details
  bhk            Int?
  bathrooms      Int?
  balconies      Int?
  carpetArea     Float?
  builtUpArea    Float?
  plotArea       Float?
  floorNumber    Int?
  totalFloors    Int?
  ageOfProperty  Int?
  furnishing     String?
  facing         String?
  possessionDate DateTime?

  // Demand signals
  unitsLeft     Int?
  viewsThisWeek Int  @default(0)

  // Project-level details (developer-led projects/townships, e.g. isFeaturedProject
  // listings) — distinct from plotArea, which is per-unit, not the project's
  // total footprint. All optional: a regular single-unit listing leaves these unset.
  // No stored `rating` field here deliberately — a partner self-reporting
  // their own project's rating would be misleading; rating is computed live
  // from real PropertyReview rows instead (see properties.service.js).
  developer     String?
  landAreaValue Float?
  landAreaUnit  String? // "acres", "sqft", etc. — free text, matches furnishing/facing convention
  openSpacePct  Int?
  totalUnits    Int?

  // Location
  address         String
  locality        String
  city            String
  state           String
  pincode         String
  // latitude/longitude are the CANONICAL coordinates — what gets displayed and
  // searched on. The two pairs below are the evidence they were decided from,
  // kept separately so 4.6's location check can show where they disagree
  // instead of silently overwriting one with the other.
  latitude        Float?
  longitude       Float?
  nearbyLandmarks String[]

  // 4.6 — a pasted map URL plus whatever coordinates could be read out of it.
  // Extraction is pure string parsing (see lib/mapLink.js), so it needs no
  // third-party geocoding service. A shortened maps.app.goo.gl link cannot be
  // parsed without following the redirect, so those store the link with null
  // coordinates rather than a guess.
  mapLink          String?
  mapLinkLatitude  Float?
  mapLinkLongitude Float?

  // 4.6 — where the partner actually dropped their pin, which is a different
  // claim from the map link and is the thing worth cross-checking.
  partnerPinLatitude  Float?
  partnerPinLongitude Float?

  // 4.7 — who last decided the canonical coordinates, and on what basis.
  // The reason text itself lives in PropertyEditLog, where every other
  // field-level override is already recorded.
  locationSource            LocationSource?
  locationVerifiedAt        DateTime?
  locationVerifiedByAdminId String?         @db.ObjectId

  // Trust & verification
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  reraNumber    String?
  bankApprovals String[]

  // 4.5 — a mortgaged unit cannot transfer without the lender's NOC, so the
  // owner-listing review needs both the flag and where the NOC has got to.
  //
  // isMortgaged is nullable on purpose. A required Boolean @default(false)
  // would be MISSING (not false) on every property that already exists,
  // because a Prisma default is only applied at create time — and a required
  // field offers no `isSet` filter, so those rows could not be queried or
  // repaired from the client at all. Nullable means `null` reads as "not
  // recorded", which is the truth for a pre-existing listing, and is
  // distinguishable from someone having actively answered "no".
  isMortgaged    Boolean?
  mortgageLender String?
  loanNocStatus  LoanNocStatus?
  loanNocUrl     String?

  // Media
  images          String[]
  videos          String[]
  coverImageIndex Int      @default(0)
  floorPlanUrl    String?
  virtualTourUrl  String?
  videoUrl        String?
  documents       Json[] // [{ name, url, uploadedAt }] — brochure, sale agreement, RERA cert, etc.

  // Amenities
  amenities       String[]
  societyFeatures String[]

  // SEO
  metaTitle       String?
  metaDescription String?

  // B2B (Phase 2)
  commissionSplitOffer String?
  // B5.9 — the "urgent" badge on the B2B feed. A listing-partner/admin flag
  // rather than something derived: "urgent" is a commercial signal the owner
  // sets, not a function of listing age or units left.
  b2bUrgent            Boolean @default(false)

  // Ownership
  partnerId String @db.ObjectId
  partner   User   @relation(fields: [partnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads               Lead[]
  favorites           Favorite[]
  constructionUpdates ConstructionUpdate[]
  editLogs            PropertyEditLog[]
  loanApplications    LoanApplication[]
  b2bConnections      B2BConnection[]
  videoTourRequests   VideoTourRequest[]
  reviews             PropertyReview[]
  rateCards           RateCard[]
  serviceTickets      ServiceTicket[]
  changeRequests      PropertyChangeRequest[]
  mandates            ExclusiveMandate[]
  conflicts           ListingConflict[]

  @@index([publishStatus, isB2BOnly])
  @@index([partnerId])
  @@index([city, publishStatus])
  @@index([isFeatured])
  @@index([city, locality, publishStatus])
  @@index([propertyType, listingType, publishStatus])
  @@index([city, propertyType, listingType, publishStatus])
  @@index([partnerId, publishStatus])
  @@index([isFeatured, publishStatus])
}

// ─── FAVORITE ─────────────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id])
  propertyId String   @db.ObjectId
  property   Property @relation(fields: [propertyId], references: [id])
  savedAt    DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}
