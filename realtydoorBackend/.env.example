NODE_ENV=development
PORT=5000

# MongoDB
DATABASE_URL=mongodb+srv://<user>:<password>@cluster0.mongodb.net/realtydoor?retryWrites=true&w=majority

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# RazorpayX — the current account escrow funds are held in and paid out from.
# Escrow release pays the seller's bank account directly (contact + fund
# account + payout) via this account number — no Razorpay Route/sub-merchant
# onboarding needed for sellers.
RAZORPAYX_ACCOUNT_NUMBER=40900000000000

# WATI WhatsApp Business API
WATI_API_ENDPOINT=https://live-mt-server.wati.io/xxxxxxxx
WATI_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS S3 (file storage)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# KYC automation (5.x) — automated PAN/GSTIN/RERA registry checks, built
# against Karza Technologies' commonly documented REST conventions. Leave
# blank to keep today's fully-manual KYC review: every check in
# lib/kycVerification.js is a no-op (no network call at all) until
# KYC_VERIFICATION_API_KEY is set. NEVER TESTED AGAINST A REAL KARZA
# ACCOUNT — verify the actual endpoint paths/response shape against Karza's
# current API docs before setting this in any real environment.
KYC_VERIFICATION_API_KEY=
KYC_VERIFICATION_BASE_URL=https://api.karza.in

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@realtydoor.com

# CORS
FRONTEND_URL=http://localhost:3000

# OTP Settings
OTP_EXPIRY_MINUTES=120
OTP_MAX_ATTEMPTS=3

# Phone/email OTP hashing (HMAC-SHA256) — required, at least 16 chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=

# Set to "true" only in local/dev to echo the OTP code in API responses for testing.
# Never set this in production — validated at runtime, not just by convention.
DEV_EXPOSE_OTP=

# Full auth bypass for local testing (Postman, scripts) — set this AND send
# `x-dev-api-key: <this value>` + `x-dev-user-email: <any real user's email>`
# to authenticate as that user with NO password/signature check at all.
# Leave blank in every real environment. The app refuses to start if this is
# set while NODE_ENV=production (see server.js) — this is not just a
# convention, it's enforced at boot.
DEV_API_KEY=

# Logging
LOG_LEVEL=debug
