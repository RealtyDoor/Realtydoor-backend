# Realtydoor API settings. GENERATED from src/config/productionSpec.js by scripts/genConfigDocs.js: do not edit by hand.
# To add or change a setting, edit the spec and run `node scripts/genConfigDocs.js`.
# Copy this file to .env for local work. Never commit .env or put a real secret in this file.

# ── Core ──────────────────────────────────────────────────────────────────
# development, production or test. No default: a forgotten value must not silently mean "not production".
# Production: Required.
NODE_ENV=development

# Port the API listens on.
# Production: Optional. Default: 5000.
PORT=5000

# Public site address; links in emails and PDFs are built from it.
# Production: Required.
FRONTEND_URL=http://localhost:3000

# Every host that may call the API (CORS), https, comma separated: site, app, admin and partner.
# Production: Required for the real launch.
FRONTEND_URLS=http://localhost:3000

# Address shown to users who need help.
# Production: Optional.
SUPPORT_EMAIL=support@example.com

# ── Database and cache ────────────────────────────────────────────────────
# MongoDB connection string. Production: the production Atlas project only.
# Production: Required.
DATABASE_URL=

# Response cache. Optional: without it the API works, slower.
# Production: Optional.
REDIS_URL=

# ── Sign-in (Clerk) and secrets ───────────────────────────────────────────
# Clerk secret key of the instance in use. Production: the production instance (sk_live_).
# Production: Required.
CLERK_SECRET_KEY=

# Signing secret of the Clerk webhook (whsec_).
# Production: Required.
CLERK_WEBHOOK_SECRET=

# Secret that hashes one-time codes. Long and random; never reuse a dev value in production.
# Production: Required, 16+ characters.
OTP_HASH_SECRET=

# Signs the audit-log chain. In production it is required, separate from OTP_HASH_SECRET, and must never change
# afterwards (the chain check would fail). Outside production it may stay empty.
# Production: Required in production, 16+ characters, different from OTP_HASH_SECRET.
AUDIT_HMAC_SECRET=

# How long a one-time code stays valid.
# Production: Optional. Default: 120.
OTP_EXPIRY_MINUTES=120

# Wrong guesses allowed on a one-time code.
# Production: Optional. Default: 3.
OTP_MAX_ATTEMPTS=3

# ── Payments (Razorpay) ───────────────────────────────────────────────────
# Razorpay key id. Real go-live: the live key (rzp_live_). A staging run may use a test key.
# Production: Required.
RAZORPAY_KEY_ID=rzp_test_xxxx

# Razorpay key secret (the same pair as the key id).
# Production: Required.
RAZORPAY_KEY_SECRET=

# Signing secret of the Razorpay webhook. A new secret for production.
# Production: Required.
RAZORPAY_WEBHOOK_SECRET=

# The RazorpayX current account that payouts are made from.
# Production: Required.
RAZORPAYX_ACCOUNT_NUMBER=

# Longest wait for a Razorpay call, in milliseconds.
# Production: Optional. Default: 30000.
RAZORPAY_TIMEOUT_MS=

# ── WhatsApp (WATI) ───────────────────────────────────────────────────────
# WATI API address for your tenant.
# Production: Required.
WATI_API_ENDPOINT=https://live-mt-server.wati.io/YOUR_TENANT

# WATI access token.
# Production: Required.
WATI_ACCESS_TOKEN=

# The WATI webhook URL carries ?token=<this value>. Required in production: without it the webhook accepts forged
# requests.
# Production: Required in production.
WATI_WEBHOOK_TOKEN=

# Templates allowed to send (comma separated; they must be approved by Meta).
# Production: Optional.
WATI_LIVE_TEMPLATES=

# Test runs only: the only numbers a message may reach. Ignored in production, so every automated message there reaches
# its real recipient.
# Production: Leave unset.
WATI_ALLOWED_NUMBERS=

# Turns on the template editing screens (development tool).
# Production: Leave unset.
WATI_TEMPLATE_EDITING=

# ── Email ─────────────────────────────────────────────────────────────────
# From address of every email. Its domain needs correct SPF, DKIM and DMARC records before launch.
# Production: Required.
EMAIL_FROM=noreply@example.com

# SMTP user; defaults to EMAIL_FROM.
# Production: Optional.
EMAIL_SMTP_USER=

# App password of the sending Gmail or Google Workspace mailbox.
# Production: Required.
GMAIL_APP_PASSWORD=

# Staff alert emails and the twice-daily digest (comma separated). Empty sends nothing.
# Production: Required for the real launch.
ADMIN_ALERT_EMAILS=

# Test runs only: the only addresses an email may reach. Ignored in production.
# Production: Leave unset.
EMAIL_ALLOWED_RECIPIENTS=

# ── File storage (AWS S3) ─────────────────────────────────────────────────
# Region of the S3 bucket and of the server.
# Production: Required.
AWS_REGION=ap-south-2

# The S3 bucket for uploads (KYC papers, listing photos, documents).
# Production: Required.
AWS_S3_BUCKET=

# Local key pair only. On AWS leave both unset so the task role supplies credentials (set both or neither).
# Production: Optional.
AWS_ACCESS_KEY_ID=

# See AWS_ACCESS_KEY_ID.
# Production: Optional.
AWS_SECRET_ACCESS_KEY=

# Extra hosts (besides the bucket) whose https links count as our own media.
# Production: Optional.
TRUSTED_MEDIA_HOSTS=

# ── Network, limits and timeouts ──────────────────────────────────────────
# How many proxies sit in front of the API: 2 behind Cloudflare plus a tunnel or ALB. Too low and every visitor looks
# like one address.
# Production: Required for the real launch. Default: 1.
TRUST_PROXY_HOPS=1

# Requests per address per 15 minutes. Leave unset in production (default 1000); a large test value must not reach
# production.
# Production: Leave unset. Default: 1000.
RATE_LIMIT_IP_MAX=

# Requests per signed-in user per 15 minutes. Leave unset in production (default 300).
# Production: Leave unset. Default: 300.
RATE_LIMIT_USER_MAX=

# Uploads per account per hour.
# Production: Optional. Default: 120.
UPLOAD_RATE_LIMIT_USER_MAX=

# Webhook calls per sender per minute.
# Production: Optional. Default: 300.
WEBHOOK_RATE_LIMIT_MAX=

# Public form submissions per address per hour.
# Production: Optional.
FORM_RATE_LIMIT_MAX=

# Largest JSON request body.
# Production: Optional. Default: 2mb.
JSON_BODY_LIMIT=

# A read that takes longer answers 503. Writes are never cut.
# Production: Optional. Default: 30000.
REQUEST_TIMEOUT_MS=

# How long a stopping server waits before it exits.
# Production: Optional. Default: 5000.
SHUTDOWN_TIMEOUT_MS=

# ── Operations and logging ────────────────────────────────────────────────
# Scheduled jobs run on this process unless this is "false". Exactly one server should run them.
# Production: Optional. Default: run.
RUN_JOBS=

# Log detail: error, warn, info or debug.
# Production: Optional. Default: info (debug outside production).
LOG_LEVEL=

# Set to "false" when the folder is read-only; the console (CloudWatch) is used either way.
# Production: Optional.
LOG_TO_FILES=

# Logs every database query. Development tool.
# Production: Leave unset.
PRISMA_QUERY_LOG=

# Shows error stacks in answers outside production. Ignored in production.
# Production: Leave unset.
EXPOSE_ERROR_STACK=

# ── KYC checks ────────────────────────────────────────────────────────────
# Key of the automatic PAN, GST and RERA check service. Empty means checks stay manual.
# Production: Optional.
KYC_VERIFICATION_API_KEY=

# Address of that service.
# Production: Optional.
KYC_VERIFICATION_BASE_URL=

# ── Development only ──────────────────────────────────────────────────────
# A login-as-anyone key for local testing. The server refuses to start in production if it is set.
# Production: Must be unset (the server refuses to start with it).
DEV_API_KEY=

# Echoes one-time codes in answers. The server refuses to start in production if it is "true".
# Production: Must be unset (the server refuses to start with it).
DEV_EXPOSE_OTP=

